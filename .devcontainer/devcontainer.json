{
  "name": "ngrok-proxy-llm",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "CODEX_CLI_VERSION": "0.142.5"
  },
  "secrets": {
    "NGROK_AUTH_TOKEN": {
      "description": "ngrok auth token used to open public tunnels from the Codespace.",
      "documentationUrl": "https://dashboard.ngrok.com/get-started/your-authtoken"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        ".env.example"
      ]
    }
  },
  "forwardPorts": [
    8330,
    8340,
    8350,
    8360
  ],
  "portsAttributes": {
    "8330": {
      "label": "LLM Proxy"
    },
    "8340": {
      "label": "Codex Bridge"
    },
    "8350": {
      "label": "CLI Bridge"
    },
    "8360": {
      "label": "Combined Router"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
