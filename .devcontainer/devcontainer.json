{
  "name": "ngrok-proxy-llm",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "secrets": {
    "NGROK_AUTH_TOKEN": {
      "description": "ngrok auth token used to open public tunnels from the Codespace.",
      "documentationUrl": "https://dashboard.ngrok.com/get-started/your-authtoken"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        ".env.example"
      ]
    }
  },
  "forwardPorts": [
    8330
  ],
  "portsAttributes": {
    "8330": {
      "label": "LLM Proxy"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
