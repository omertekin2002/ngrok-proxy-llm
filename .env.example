# Required: get this from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# Optional: use a reserved ngrok domain if your plan supports it
# Used by single-service runners and by the combined public router for `make run`.
# NGROK_DOMAIN=your-subdomain.ngrok.app

# Optional: reserved domain for the combined `make run` command.
# Overrides NGROK_DOMAIN for the combined public router only.
# COMBINED_NGROK_DOMAIN=your-combined-subdomain.ngrok.app

# Optional: ngrok region (us, eu, ap, au, sa, jp, in)
# NGROK_REGION=us

# Optional: ngrok auto-reconnect watchdog tuning
# NGROK_DISABLE_AUTO_RECONNECT=false
# NGROK_RECONNECT_CHECK_SECONDS=15
# NGROK_RECONNECT_FAILURE_THRESHOLD=2
# NGROK_RECONNECT_MAX_ATTEMPTS=0
# NGROK_RECONNECT_INITIAL_BACKOFF_SECONDS=1.0

# Optional: local LLM server URL used by `make run` / `make run-llm`
# LLM_LOCAL_URL=http://localhost:8317

# Optional: local endpoint for direct tunnel mode (`make run-llm-direct`)
# LOCAL_URL=http://localhost:8317

# Optional: local LLM retry-proxy port (`make run` / `make run-llm`)
# LLM_PROXY_PORT=8330

# Optional: local Codex bridge port (`make run-codex`)
# CODEX_BRIDGE_PORT=8340

# Optional: local CLI bridge port (`make run`)
# CLI_BRIDGE_PORT=8350

# Optional: combined public router port (`make run`)
# COMBINED_PROXY_PORT=8360

# Optional: combined `make run` startup timeout in seconds
# RUN_ALL_STARTUP_TIMEOUT=120

# Optional: LLM-only proxy startup timeout in seconds
# LLM_PROXY_STARTUP_TIMEOUT=120

# Optional: bearer token required by the CLI bridge.
# Falls back to CODEX_BRIDGE_AUTH_TOKEN if unset.
# CLI_BRIDGE_AUTH_TOKEN=change_me

# Optional: default providers for `make run`
# CLI_BRIDGE_PROVIDERS=codex
# CLI_BRIDGE_DEFAULT_PROVIDER=codex

# Optional: explicit models routed to the CLI bridge by the combined public router
# ROUTER_CLI_MODELS=codex-cli

# Optional: Codex bridge startup timeout in seconds
# CODEX_BRIDGE_STARTUP_TIMEOUT=120

# Optional: bearer token required by the Codex bridge.
# Strongly recommended before exposing the bridge over ngrok.
# CODEX_BRIDGE_AUTH_TOKEN=change_me

# Optional: Codex CLI binary path/name
# CODEX_BINARY=codex

# Optional: working directory passed to `codex exec -C`
# CODEX_WORKDIR=/absolute/path/to/workdir

# Optional: sandbox passed to `codex exec --sandbox`
# CODEX_SANDBOX=read-only

# Optional: Codex profile/model overrides. Setting a profile disables
# CODEX_IGNORE_USER_CONFIG because named profiles live in user configuration.
# CODEX_PROFILE=
# CODEX_MODEL=

# Optional: additional writable directories for Codex, comma-separated
# CODEX_ADD_DIRS=/absolute/path/one,/absolute/path/two

# Optional: Codex exec runtime behavior
# CODEX_EPHEMERAL=true
# CODEX_SKIP_GIT_REPO_CHECK=false
# CODEX_ENABLE_WEB_SEARCH=false
# CODEX_IGNORE_USER_CONFIG=true
# CODEX_MAX_CONCURRENCY=1
# CODEX_REQUEST_TIMEOUT_SECONDS=900
# CODEX_MAX_EVENT_BYTES=2097152
# CODEX_MAX_STDERR_BYTES=65536
# CODEX_MAX_RESULT_BYTES=4194304
# CODEX_TERMINATE_GRACE_SECONDS=3

# Optional: CLI bridge attachment limits for JSON multimodal and multipart requests
# CLI_BRIDGE_MAX_ATTACHMENTS=8
# CLI_BRIDGE_MAX_ATTACHMENT_BYTES=10485760
# CLI_BRIDGE_MAX_TOTAL_ATTACHMENT_BYTES=26214400
# Defaults to twice the total attachment limit plus 1 MiB (51 MiB with defaults).
# CLI_BRIDGE_MAX_REQUEST_BYTES=53477376
# CLI_BRIDGE_ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=15
# CLI_BRIDGE_TEXT_PREVIEW_CHARS=12000
# CLI_BRIDGE_ALLOW_LOCAL_FILE_REFERENCES=false
# Remote URL downloads are disabled by default; enable only for trusted clients.
# CLI_BRIDGE_ALLOW_REMOTE_URLS=false
# CLI_BRIDGE_MAX_QUEUED_REQUESTS=4

# Optional: retries for LLM proxy requests
# PROXY_RETRY_ATTEMPTS=2
# PROXY_RETRY_BACKOFF_SECONDS=0.35
# PROXY_RETRY_MAX_BACKOFF_SECONDS=2.0
# POST retries are opt-in because they can duplicate generations and cost.
# PROXY_RETRY_METHODS=GET,HEAD

# Optional: retry 429 responses (disabled by default).
# When enabled, proxy also respects Retry-After (seconds or HTTP date) if provided,
# capped by PROXY_RETRY_429_MAX_DELAY_SECONDS.
# PROXY_RETRY_ON_429=false
# PROXY_RETRY_429_MAX_DELAY_SECONDS=30

# Optional: for non-streaming requests, buffer full upstream response before sending
# (reduces stream-interrupted errors for /v1/responses stream=false)
# PROXY_BUFFER_NON_STREAMING=true

# Optional: LLM readiness path, body limits, and finite upstream timeouts
# LLM_HEALTH_PATH=/v1/models
# PROXY_MAX_REQUEST_BODY_BYTES=41943040
# PROXY_MAX_NONSTREAM_RESPONSE_BYTES=67108864
# PROXY_CONNECT_TIMEOUT_SECONDS=15
# PROXY_WRITE_TIMEOUT_SECONDS=60
# PROXY_READ_TIMEOUT_SECONDS=300
# PROXY_POOL_TIMEOUT_SECONDS=30
# PROXY_HEALTH_TIMEOUT_SECONDS=10

# Optional: combined router limits and finite downstream timeouts
# Request limit defaults to the larger of the LLM and CLI request limits.
# ROUTER_MAX_REQUEST_BODY_BYTES=53477376
# ROUTER_MAX_NONSTREAM_RESPONSE_BYTES=67108864
# ROUTER_CONNECT_TIMEOUT_SECONDS=15
# ROUTER_WRITE_TIMEOUT_SECONDS=60
# ROUTER_READ_TIMEOUT_SECONDS=930
# ROUTER_POOL_TIMEOUT_SECONDS=30
# ROUTER_HEALTH_TIMEOUT_SECONDS=10
# ROUTER_MODELS_TIMEOUT_SECONDS=30
